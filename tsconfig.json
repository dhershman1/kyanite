{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noImplicitAny": false,
    "noEmitOnError": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "module": "nodenext",
    "target": "es2022",
    "lib": ["es2022"],
    "rootDir": "src",
    "outDir": ".types"
  },
  "include": ["src"]
}
